{
  "manifest_version": 3,
  "name": "Campus Job Agent · OfferBiu Bridge",
  "version": "0.1.0",
  "description": "将当前登录会话可见的 OfferBiu 岗位安全同步到本机岗位库。",
  "host_permissions": [
    "https://offerbiu.com/*",
    "http://127.0.0.1:4317/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://offerbiu.com/companies/*",
        "https://offerbiu.com/jobs/new/*"
      ],
      "js": ["core.js", "page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://offerbiu.com/companies/*",
        "https://offerbiu.com/jobs/new/*"
      ],
      "js": ["core.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
